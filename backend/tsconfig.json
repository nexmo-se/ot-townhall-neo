{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "lib": [ "es6", "dom" ],
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./build",
    "baseUrl": "./src",
    "allowJs": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "mongodb": [
        "types/mongodb"
      ],
        "*": [
            "node_modules/*",
            "src/types/*"
        ]
    }
  },
  "include": [ "./src/**/*" ]
}