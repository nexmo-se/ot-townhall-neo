  "devDependencies": {
    "@types/cors": "2.8.12",
    "@types/express": "4.17.13",
    "@types/lodash": "4.14.172",
    "@types/morgan": "1.9.3",
    "@types/node": "16.7.1",
    "@types/opentok": "2.10.2",
    "@types/pg": "8.6.1",
    "@types/uuid": "8.3.1",
    "@types/luxon": "2.0.0",
    "nodemon": "2.0.12",
    "rimraf": "3.0.2",
    "ts-node": "10.2.1",
    "typescript": "4.3.5"
  },
  "dependencies": {
    "core-js": "3.16.3",
    "cors": "2.8.5",
    "crypto": "1.0.1",
    "dotenv": "10.0.0",
    "express": "4.17.1",
    "express-async-handler": "1.1.4",
    "express-validation": "3.0.8",
    "firebase-admin": "9.11.1",
    "lodash": "4.17.21",
    "luxon": "2.0.2",
    "mongo-dot-notation": "2.0.0",
    "mongodb": "4.1.1",
    "morgan": "1.10.0",
    "opentok": "2.12.0",
    "pg": "8.7.1",
    "uuid": "8.3.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
